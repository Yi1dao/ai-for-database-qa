# ---------- 运行环境 ----------
APP_ENV=dev

# ---------- MySQL ----------
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=chat_bi

# 连接与超时（秒）
DB_CONNECT_TIMEOUT=5
DB_READ_TIMEOUT=8
DB_WRITE_TIMEOUT=8

# 连接池
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=3
DB_SLOW_QUERY_THRESHOLD_MS=200

# ---------- LLM（LangChain） ----------
API_KEY=sk-3841782fe21c427fb3b6acd1fefa0552
BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.8-flash
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
LLM_MAX_TOKENS=4000

# ---------- 功能开关 ----------
FEATURE_FEW_SHOT=true
FEATURE_RULES=true
FEATURE_GUARDS=true
FEATURE_INDICATOR_KNOWLEDGE=true
FEATURE_SCHEMA_LINKING=false
FEATURE_INDICATOR_RAG=false